# Keep the mandatory Zsh entry point minimal; the configuration lives together
# with the other Zsh files under ~/.config/zsh.
zsh_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/zsh
if [[ -r ${zsh_config_dir}/zshrc.zsh ]]; then
  source "${zsh_config_dir}/zshrc.zsh"
fi
unset zsh_config_dir

# pnpm
export PNPM_HOME='/Users/masato.nagashima/Library/pnpm'
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end
