{{- $is_wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{-     $is_wsl = true -}}
{{-   end -}}
{{- end -}}

{{- $is_mac := eq .chezmoi.os "darwin" -}}

{{- $skill := "" -}}
{{- if $is_mac -}}
{{-   $bin := lookPath "terminal-browser" -}}
{{-   if $bin -}}
{{/* 実行ファイルのリンクを解決し、インストール先からスキルのパスを求める */}}
{{-     $real := output "realpath" $bin | trim -}}
{{-     $skill = joinPath (dir (dir $real)) "skills" "default" "terminal-browser" -}}
{{-   end -}}
{{- else if $is_wsl -}}
{{-   $skill = "" -}}
{{- end }}

[data]
    terminal_browser_skill_dir = {{ $skill | quote }}
    is_wsl = {{ $is_wsl }}
    is_mac = {{ $is_mac }}
