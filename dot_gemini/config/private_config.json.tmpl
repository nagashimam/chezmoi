{{- $cfg := include "shared-agent-config.json" | fromJson -}}
{{- $allows := list -}}
{{- range $cmd := $cfg.safeCommands -}}
  {{- $allows = append $allows (printf "command(%s)" $cmd) -}}
{{- end -}}
{{- range $domain := $cfg.safeDomains -}}
  {{- $allows = append $allows (printf "read_url(%s)" $domain) -}}
{{- end -}}
{
  "userSettings": {
    "remoteControlHostname": "macbook-pro-local-galactic-shard",
    "globalPermissionGrants": {
      "allow": {{ $allows | toJson }}
    }
  }
}
