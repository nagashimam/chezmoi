# ~/.config/ghostty/config
# Managed by chezmoi (dot_config/ghostty/config.tmpl).

# --- Font ---------------------------------------------------------------
# HackGen Console: Hack + 源柔ゴシックの合成フォント。日本語グリフを含み、
# 記号類を半角幅に寄せているため端末でのカラム崩れが起きにくい
# (yuru7/HackGen README で確認、要 `brew install --cask font-hackgen`)。
font-family = HackGen Console
font-size = 14

# --- Theme ----------------------------------------------------------------
theme = TokyoNight Night

# --- Window -----------------------------------------------------------------
{{- if .is_wsl }}
# On WSL2/WSLg, window & per-cell alpha blending over RDP rail + software
# rendering (llvmpipe) is extremely expensive. Keep surfaces opaque.
background-opacity = 1.0
background-opacity-cells = false
window-vsync = false
gtk-toolbar-style = flat
{{- else }}
background-opacity = 0.80
# Apply the same opacity to explicit cell backgrounds, including Neovim.
background-opacity-cells = true
window-vsync = true
{{- end }}
background-blur = false
window-padding-x = 8
window-padding-y = 8
confirm-close-surface = false

# --- Behavior -----------------------------------------------------------
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1
scrollback-limit = 10000000

# --- JIS keyboard: ¥ key fix ------------------------------------------------
# Ghostty defines a distinct physical key `intl_yen` for the dedicated ¥ key
# found on JIS keyboards (sits between `=` and Backspace) — confirmed against
# ghostty-org/ghostty's src/input/key.zig. It is its own physical key, not an
# Option/Alt-modified combination, so no alt+ prefix is needed here. This
# corrects the earlier draft plan, which had `alt+intl_yen=text:\\`.
#
# `text:` uses Zig string-literal escaping, so `\\` sends one literal
# backslash character.
keybind = intl_yen=text:\\

# --- Kitty Graphics Protocol ---------------------------------------------
# No config key was found to "enable" KGP — Ghostty implements it natively
# and it is on by default, nothing to set here.

{{- if .is_wsl }}
# Use C.UTF-8 on WSL/Ubuntu where ja_JP.UTF-8 is not generated by default
env = LANG=C.UTF-8
env = LC_ALL=C.UTF-8
{{- else }}
env = LANG=ja_JP.UTF-8
env = LC_ALL=ja_JP.UTF-8
{{- end }}
